# .dockerignore
# Tells Docker what NOT to copy into the container during build.
# This reduces build context size and speeds up builds.

# ============================================
# Git & Version Control
# ============================================
.git
.gitignore
.gitattributes
.github/

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
*.egg
build/
dist/

# ============================================
# Virtual Environments
# ============================================
.venv/
venv/
ENV/
env/

# ============================================
# IDE & Editors
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# ============================================
# OS Files
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# Environment & Secrets
# ============================================
.env
.env.*
!.env.example

# ============================================
# Documentation (exclude from production)
# ============================================
docs/
*.md
!README.md
LICENSE

# ============================================
# Tests (not needed in production container)
# ============================================
tests/
test_*.py
*_test.py
conftest.py

# ============================================
# Scripts (typically for local dev)
# ============================================
scripts/

# ============================================
# Data Files (mount at runtime or fetch)
# ============================================
# data/ folder excluded (documentation files not needed in image)
qdrant_storage/
*.db
*.sqlite

# ============================================
# Infrastructure (Docker/AWS configs)
# ============================================
infra/
Dockerfile*
docker-compose*.yml
*.dockerfile

# ============================================
# CI/CD
# ============================================
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# ============================================
# Logs & Temporary Files
# ============================================
*.log
logs/
tmp/
temp/

# ============================================
# Large Model Files (download at runtime)
# ============================================
*.bin
*.safetensors
*.gguf
*.pt
*.pth
models/
checkpoints/

