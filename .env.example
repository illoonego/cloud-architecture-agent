# LLM Configuration
# IMPORTANT: EC2 public IP changes every time you stop/start the instance
# Get current IP: aws ec2 describe-instances --instance-ids i-YOUR-INSTANCE-ID --query 'Reservations[0].Instances[0].PublicIpAddress' --output text
# Or check AWS Console → EC2 → Instances → Select instance → Public IPv4 address
VLLM_API_URL=http://YOUR_EC2_PUBLIC_IP:8000/v1
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# RAG Configuration
# For local development with Docker
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3

# API Configuration
PROJECT_NAME=Cloud Architecture Agent
API_V1_STR=/api/v1

# HuggingFace Token (required for gated models)
# Get from: https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=hf_your_token_here
