# Runtime overrides and secrets only.
# Other values use defaults from src/config/settings.py.

# LLM endpoint (EC2 Elastic IP)
VLLM_API_URL=http://YOUR_ELASTIC_IP:8000/v1

# AWS Secrets Manager config (required for API auth)
# SecretString must include API keys, for example:
# {"API_KEYS":"your-key-1,your-key-2"}
AWS_SECRET_NAME=cloud-architecture-agent/prod
AWS_REGION=us-east-1
