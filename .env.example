# LLM Configuration
# Use Elastic IP (static) - won't change on EC2 stop/start
# If you don't have an Elastic IP allocated, the public IP changes every restart
# Elastic IP setup: AWS Console → EC2 → Elastic IPs → Allocate → Associate with instance
VLLM_API_URL=http://YOUR_ELASTIC_IP:8000/v1
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# RAG Configuration
# For local development with Docker
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3

# API Configuration
PROJECT_NAME=Cloud Architecture Agent
API_V1_STR=/api/v1

# HuggingFace Token (required for gated models)
# Get from: https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=hf_your_token_here
